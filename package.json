{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "data:export": "node scripts/export-data.mjs",
    "db:schema": "wrangler d1 execute game-pedia --remote --file=db/schema.sql",
    "db:seed": "wrangler d1 execute game-pedia --remote --file=db/seed.sql",
    "db:seed:generate": "node scripts/generate-seed.mjs",
    "db:migrate": "node scripts/migrate.cjs",
    "db:query": "wrangler d1 execute game-pedia --remote",
    "prices:resolve": "node scripts/resolve-store-ids.cjs",
    "prices:links": "node scripts/resolve-store-links.cjs",
    "prices:links:apply": "node scripts/resolve-store-links.cjs --apply",
    "prices:sync": "node scripts/sync-prices.cjs",
    "prices:apply": "node scripts/sync-prices.cjs --apply"
  },
  "dependencies": {
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.7",
    "wrangler": "^4.166.0"
  }
}
